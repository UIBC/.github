{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/UIBC/.github/main/registry/schema.json",
  "title": "UIBC Registry index",
  "type": "object",
  "required": ["schema", "updated", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "uibc-registry/1"},
    "updated": {"type": "string", "format": "date"},
    "entries": {"type": "array", "items": {"$ref": "#/definitions/entry"}}
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["id", "namespace", "subject", "version", "state", "code", "since", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"},
        "namespace": {"type": "string", "pattern": "^(github\\.com|code\\.|io\\.|com\\.|org\\.)[^ ]+$"},
        "subject": {"type": "string", "minLength": 3},
        "version": {"type": "string", "minLength": 1},
        "state": {
          "enum": ["submitted", "checked", "independent", "superseded", "revoked", "withdrawn"]
        },
        "code": {"enum": ["author", "independent"]},
        "since": {"type": "string", "format": "date"},
        "evidence": {"type": "string", "pattern": "^https://"},
        "receipt": {"type": "string", "pattern": "^https://"},
        "superseded_by": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"},
        "target_root": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
        "notes": {"type": "string", "maxLength": 400}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"enum": ["superseded"]}}, "required": ["state"]},
          "then": {"required": ["superseded_by"]}
        },
        {
          "if": {"properties": {"state": {"enum": ["revoked"]}}, "required": ["state"]},
          "then": {"required": ["target_root"]}
        },
        {
          "if": {"properties": {"state": {"enum": ["checked", "independent"]}}, "required": ["state"]},
          "then": {"required": ["receipt"]}
        },
        {
          "if": {"properties": {"state": {"const": "independent"}}, "required": ["state"]},
          "then": {"properties": {"code": {"const": "independent"}}}
        }
      ]
    }
  }
}
